# Copy this file to ".env" and put your real key in it.
# .env is gitignored; the key stays on the machine running the server and is
# never sent to the browser.

# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Leave blank and the server asks the API which models exist and
# picks a current vision-capable flash model itself.
GEMINI_MODEL=

# Optional. Defaults to 8123.
PORT=
